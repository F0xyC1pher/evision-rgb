#!/usr/bin/env python3
"""Vanilla Terraria RGB bridge: read player HP from process memory and send
colors to the EVision OpenRGB SDK bridge. No game mods are required.

Run with sudo (needed to read /proc/<pid>/mem when ptrace_scope=1).
"""
import argparse
import os
import pwd
import socket
import struct
import time

# Prefix found in Terraria's player structure: 09 00 00 00 <max> <max>
# followed by a 4-byte little-endian current HP.


def find_pid():
    for pid in os.listdir("/proc"):
        if not pid.isdigit():
            continue
        try:
            cmd = open(f"/proc/{pid}/cmdline", "rb").read()
        except OSError:
            continue
        if b"Terraria.bin" in cmd:
            return int(pid)
    return None


def open_mem(pid):
    return os.open(f"/proc/{pid}/mem", os.O_RDONLY)


def find_hp_address(pid, mem, max_hp, prefer=None):
    """Find the player HP field by structure shape, preferring the last
    known good HP/mana pair after a respawn moves the player object."""
    pair = struct.pack("<II", max_hp, max_hp)
    candidates = []
    result = None
    for line in open(f"/proc/{pid}/maps"):
        p = line.split()
        if len(p) < 5 or "rw-p" not in p[1]:
            continue
        a, b = p[0].split("-")
        a, b = int(a, 16), int(b, 16)
        for off in range(a, b, 8 * 1024 * 1024):
            try:
                data = os.pread(mem, min(8 * 1024 * 1024 + 64, b - off), off)
            except OSError:
                continue
            start = 0
            found = None
            while True:
                i = data.find(pair, start)
                if i < 0:
                    break
                addr = off + i + 8
                hp = read_hp(mem, addr)
                mana = read_hp(mem, addr + 4)
                if (hp is not None and mana is not None and
                        0 < hp <= max_hp and 20 <= mana <= 500 and
                        read_hp(mem, addr + 8) == mana and
                        read_hp(mem, addr + 12) == mana):
                    candidates.append((addr, hp, mana))
                start = i + 1
    if prefer:
        for addr, hp, mana in candidates:
            if hp == prefer[0] and mana == prefer[1]:
                return addr, max_hp
    if candidates:
        return candidates[0][0], max_hp
    return None, None

def read_hp(mem, addr):
    try:
        return struct.unpack("<I", os.pread(mem, 4, addr))[0]
    except OSError:
        return None


# LED slots from the keyboard keymap
F_KEYS   = [8, 16, 24, 32, 40, 48, 56, 64, 72, 80]   # F1..F10
NUM_KEYS = [9, 17, 25, 33, 41, 49, 57, 65, 73, 81]  # number row 1..0
WASD     = [18, 11, 19, 27]                          # W A S D
FOREST_OFF, DESERT_OFF, SNOW_OFF = -1116, -992, -1164
BIOME_COLORS = {"forest": (0, 255, 0), "desert": (255, 200, 0),
                "snow": (0, 200, 255), "unknown": (40, 40, 40)}

KEY_SLOTS = {"esc": 0, "grave": 1, "tab": 2, "caps": 3, "numlock": 6, "f1": 8, "1": 9, "q": 10, "a": 11, "numslash": 14, "f2": 16, "2": 17, "w": 18, "s": 19, "z": 20, "numasterisk": 22, "f3": 24, "3": 25, "e": 26, "d": 27, "x": 28, "numminus": 30, "f4": 32, "4": 33, "r": 34, "f": 35, "c": 36, "num7": 38, "f5": 40, "5": 41, "t": 42, "g": 43, "v": 44, "space": 45, "num8": 46, "f6": 48, "6": 49, "y": 50, "h": 51, "b": 52, "num9": 54, "f7": 56, "7": 57, "u": 58, "j": 59, "n": 60, "num4": 62, "f8": 64, "8": 65, "i": 66, "k": 67, "m": 68, "num5": 70, "f9": 72, "9": 73, "o": 74, "l": 75, "comma": 76, "num6": 78, "f10": 80, "0": 81, "p": 82, "semicolon": 83, "period": 84, "numplus": 86, "f11": 88, "minus": 89, "leftbracket": 90, "quote": 91, "slash": 92, "num2": 94, "f12": 96, "equal": 97, "rightbracket": 98, "num3": 102, "prtsc": 104, "backspace": 105, "backslash": 106, "enter": 107, "left": 109, "num0": 110, "scrlk": 112, "insert": 113, "delete": 114, "pgup": 115, "up": 116, "down": 117, "numdot": 118, "pause": 120, "home": 121, "end": 122, "pgdn": 123, "num1": 124, "right": 125, "numenter": 126}

def _user_home():
    user = os.environ.get("SUDO_USER") or os.environ.get("USER")
    if user:
        try:
            return pwd.getpwnam(user).pw_dir
        except KeyError:
            pass
    return os.path.expanduser("~")


CONFIG = os.path.join(_user_home(), ".local/share/Terraria/input profiles.json")
_KEY_ALIASES = {
    "escape": "esc", "back": "backspace", "capslock": "caps",
    "leftshift": "lshift", "rightshift": "rshift",
    "leftcontrol": "lctrl", "rightcontrol": "rctrl",
    "leftalt": "lalt", "rightalt": "ralt",
    "add": "numplus", "subtract": "numminus",
    "multiply": "numasterisk", "divide": "numslash",
    "pageup": "pgup", "pagedown": "pgdn", "printscreen": "prtsc",
    "oemplus": "equal", "oemminus": "minus",
}


def config_key_to_slot(key):
    if not isinstance(key, str) or key.startswith("Mouse"):
        return None
    if len(key) == 2 and key[0] == "D" and key[1].isdigit():
        key = key[1]              # D1 -> 1, D0 -> 0
    name = key.lower()
    name = _KEY_ALIASES.get(name, name)
    return KEY_SLOTS.get(name)


def read_bindings(cache):
    """Read Terraria key bindings every second (the game may rewrite them in-place)."""
    now = time.time()
    if now - cache.get("checked", 0.0) < 1.0:
        return cache.get("bindings", {})
    cache["checked"] = now
    import json
    try:
        data = json.load(open(CONFIG))
        profile = data.get("Selected Profile", "Custom")
        kb = data[profile]["Mouse And Keyboard"]
        bindings = {}
        for action, keys in kb.items():
            if not keys:
                continue
            slot = config_key_to_slot(keys[0])
            if slot is not None:
                bindings[action] = slot
    except (OSError, KeyError, ValueError):
        bindings = cache.get("bindings", {})
    cache["bindings"] = bindings
    return bindings


# XNA key codes used by Terraria -> names in our LED keymap
_NAME_TO_KEYCODE = {
    "esc": 27, "space": 32, "tab": 9, "enter": 13, "backspace": 8,
    "lshift": 160, "rshift": 161, "lctrl": 162, "rctrl": 163,
    "lalt": 164, "ralt": 165, "pgup": 33, "pgdn": 34,
    "home": 36, "end": 35, "insert": 45, "delete": 46,
    "numplus": 107, "numminus": 109, "numasterisk": 106, "numslash": 111,
    "up": 38, "down": 40, "left": 37, "right": 39,
    "leftbracket": 219, "rightbracket": 220, "semicolon": 186, "quote": 222,
    "comma": 188, "period": 190, "slash": 191, "backslash": 220,
    "minus": 189, "equal": 187, "grave": 192,
}
for _i, _c in enumerate("abcdefghijklmnopqrstuvwxyz"):
    _NAME_TO_KEYCODE[_c] = ord(_c.upper())
for _i in range(10):
    _NAME_TO_KEYCODE[str(_i)] = 48 + _i
for _i in range(1, 13):
    _NAME_TO_KEYCODE[f"f{_i}"] = 111 + _i
KEYCODE_TO_SLOT = {code: KEY_SLOTS[name] for name, code in _NAME_TO_KEYCODE.items()
                   if name in KEY_SLOTS}

# Signature of the keybinding array in Terraria memory (Up..QuickMount).
_BIND_SIG = struct.pack("<11I", 87, 83, 65, 68, 32, 84, 69, 81, 160, 162, 82)


def find_bindings_arrays(pid, mem):
    """Locate all keybinding arrays in game memory."""
    result = []
    for line in open(f"/proc/{pid}/maps"):
        p = line.split()
        if len(p) < 5 or "rw-p" not in p[1]:
            continue
        a, b = p[0].split("-")
        a, b = int(a, 16), int(b, 16)
        for off in range(a, b, 8 * 1024 * 1024):
            try:
                data = os.pread(mem, min(8 * 1024 * 1024 + 64, b - off), off)
            except OSError:
                continue
            start = 0
            found = None
            while True:
                i = data.find(_BIND_SIG, start)
                if i < 0:
                    break
                found = off + i
                start = i + 1
            if found is not None:
                result.append(found)
    return result


def find_bindings_array(pid, mem):
    arrays = find_bindings_arrays(pid, mem)
    return arrays[0] if arrays else None

def live_bindings(mem, base):
    """Read QuickHeal/QuickMana/QuickBuff keycodes from the live array."""
    out = {}
    # _BIND_SIG starts at array index 6; QuickHeal is index 17 => +11
    for action, index in (("QuickHeal", 11), ("QuickMana", 12),
                          ("QuickBuff", 13)):
        code = read_hp(mem, base + index * 4)
        if code is not None:
            out[action] = KEYCODE_TO_SLOT.get(code)
    return out


def bar_color(pct, low=(255, 0, 0), high=(0, 255, 0)):
    pct = max(0.0, min(1.0, pct))
    return tuple(int(low[i] + (high[i] - low[i]) * pct) for i in range(3))


def connect_sdk(port):
    s = socket.create_connection(("127.0.0.1", port), timeout=3)
    s.settimeout(3)
    return s


def send_colors(s, colors):
    inner = struct.pack("<H", 128) + b"".join(
        struct.pack("<BBBB", c[0], c[1], c[2], 255) for c in colors)
    payload = struct.pack("<I", 4 + len(inner)) + inner
    s.sendall(b"ORGB" + struct.pack("<III", 0, 1050, len(payload)) + payload)


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--port", type=int, default=6742)
    ap.add_argument("--hz", type=float, default=5.0)
    ap.add_argument("--max-hp", type=int, default=100)
    ap.add_argument("--list-binds", action="store_true",
                    help="list candidate binding arrays and exit")
    ap.add_argument("--bind-addr", type=str, default=None,
                    help="binding array address (0x...)")
    ap.add_argument("--addr", type=str, default=None,
                    help="HP field address from a previous run (0x...)")
    args = ap.parse_args()

    if os.geteuid() != 0:
        raise SystemExit("Run with sudo: sudo terraria-rgb")

    pid = find_pid()
    if not pid:
        raise SystemExit("Terraria process not found")
    mem = open_mem(pid)
    if args.list_binds:
        for base in find_bindings_arrays(pid, mem):
            vals = live_bindings(mem, base)
            print(f"{hex(base)}  heal={vals.get('QuickHeal')} "
                  f"mana={vals.get('QuickMana')} buff={vals.get('QuickBuff')}")
        os.close(mem)
        return
    if args.addr:
        addr, max_hp = int(args.addr, 0), args.max_hp
    else:
        addr, max_hp = find_hp_address(pid, mem, args.max_hp)
    if addr is None:
        raise SystemExit("HP pattern not found (game version may differ)")
    print(f"Terraria pid={pid} HP address={hex(addr)} max={max_hp}", flush=True)

    s = connect_sdk(args.port)
    interval = 1.0 / args.hz
    cfg_cache = {}
    last_good = None
    bind_base = int(args.bind_addr, 0) if args.bind_addr else find_bindings_array(pid, mem)
    if bind_base:
        print(f"bindings array at {hex(bind_base)}", flush=True)
    try:
        while True:
            hp = read_hp(mem, addr)
            mana_raw = read_hp(mem, addr + 4)
            max_mana_raw = read_hp(mem, addr + 8)
            if hp is None:
                break
            # all-zero block means the player object moved (respawn)
            if (hp == 0 and mana_raw == 0 and max_mana_raw == 0) or hp > max_hp:
                addr, max_hp = find_hp_address(pid, mem, args.max_hp, last_good)
                print(f"[rescan] addr={hex(addr) if addr else None} "
                      f"prefer={last_good}", flush=True)
                if addr is None:
                    break
                hp = read_hp(mem, addr)
                mana_raw = read_hp(mem, addr + 4)
                max_mana_raw = read_hp(mem, addr + 8)
            if hp and mana_raw:
                last_good = (hp, mana_raw)
            mana = mana_raw or 0
            max_mana = max_mana_raw or 120
            colors = [(0, 0, 0)] * 128
            hp_c = bar_color(hp / max(1, max_hp))
            mana_c = bar_color(mana / max(1, max_mana),
                               low=(60, 0, 255), high=(0, 160, 255))
            for i, slot in enumerate(F_KEYS):
                colors[slot] = (255, 0, 0) if hp == 0 else (
                    hp_c if i < round(10 * hp / max(1, max_hp)) else (0, 0, 0))
            for i, slot in enumerate(NUM_KEYS):
                colors[slot] = mana_c if i < round(10 * mana / max(1, max_mana)) else (0, 0, 0)
            forest = read_hp(mem, addr + FOREST_OFF)
            desert = read_hp(mem, addr + DESERT_OFF)
            snow = read_hp(mem, addr + SNOW_OFF)
            if forest == 10:
                biome = "forest"
            elif desert == 1:
                biome = "desert"
            elif snow == 5:
                biome = "snow"
            else:
                biome = "unknown"
            for slot in WASD:
                colors[slot] = BIOME_COLORS[biome]

            binds = (live_bindings(mem, bind_base) if bind_base else {})
            if not binds.get("QuickHeal"):
                binds = read_bindings(cfg_cache)
            heal_slot = binds.get("QuickHeal")
            mana_slot = binds.get("QuickMana")
            if heal_slot is not None:
                miss = 1.0 - hp / max(1, max_hp)
                colors[heal_slot] = (60 + int(195 * miss), 0, 0)
            if mana_slot is not None:
                miss = 1.0 - mana / max(1, max_mana)
                colors[mana_slot] = (0, 0, 60 + int(195 * miss))
            send_colors(s, colors)
            time.sleep(interval)
    except KeyboardInterrupt:
        pass
    finally:
        s.close()
        os.close(mem)


if __name__ == "__main__":
    main()
