#!/usr/bin/env python3
"""Vanilla Terraria RGB bridge: read player HP from process memory and send
colors to the EVision OpenRGB SDK bridge. No game mods are required.

Run with sudo (needed to read /proc/<pid>/mem when ptrace_scope=1).
"""
import argparse
import os
import socket
import struct
import time

# Prefix found in Terraria's player structure: 09 00 00 00 <max> <max>
# followed by a 4-byte little-endian current HP.


def find_pid():
    for pid in os.listdir("/proc"):
        if not pid.isdigit():
            continue
        try:
            cmd = open(f"/proc/{pid}/cmdline", "rb").read()
        except OSError:
            continue
        if b"Terraria.bin" in cmd:
            return int(pid)
    return None


def open_mem(pid):
    return os.open(f"/proc/{pid}/mem", os.O_RDONLY)


def find_hp_address(pid, mem, max_hp):
    prefix = struct.pack("<III", 9, max_hp, max_hp)
    for line in open(f"/proc/{pid}/maps"):
        p = line.split()
        if len(p) < 5 or "rw-p" not in p[1]:
            continue
        a, b = p[0].split("-")
        a, b = int(a, 16), int(b, 16)
        for off in range(a, b, 8 * 1024 * 1024):
            try:
                data = os.pread(mem, min(8 * 1024 * 1024 + 32, b - off), off)
            except OSError:
                continue
            start = 0
            while True:
                i = data.find(prefix, start)
                if i < 0:
                    break
                addr = off + i + len(prefix)
                hp = read_hp(mem, addr)
                if hp is not None and 0 < hp <= max_hp:
                    return addr, max_hp
                start = i + 1
    return None, None


def read_hp(mem, addr):
    try:
        return struct.unpack("<I", os.pread(mem, 4, addr))[0]
    except OSError:
        return None


# LED slots from the keyboard keymap
F_KEYS   = [8, 16, 24, 32, 40, 48, 56, 64, 72, 80]   # F1..F10
NUM_KEYS = [9, 17, 25, 33, 41, 49, 57, 65, 73, 81]  # number row 1..0
WASD     = [18, 11, 19, 27]                          # W A S D
FOREST_OFF, DESERT_OFF, SNOW_OFF = -1116, -992, -1164
BIOME_COLORS = {"forest": (0, 255, 0), "desert": (255, 200, 0),
                "snow": (0, 200, 255), "unknown": (40, 40, 40)}


def bar_color(pct, low=(255, 0, 0), high=(0, 255, 0)):
    pct = max(0.0, min(1.0, pct))
    return tuple(int(low[i] + (high[i] - low[i]) * pct) for i in range(3))


def connect_sdk(port):
    s = socket.create_connection(("127.0.0.1", port), timeout=3)
    s.settimeout(3)
    return s


def send_colors(s, colors):
    inner = struct.pack("<H", 128) + b"".join(
        struct.pack("<BBBB", c[0], c[1], c[2], 255) for c in colors)
    payload = struct.pack("<I", 4 + len(inner)) + inner
    s.sendall(b"ORGB" + struct.pack("<III", 0, 1050, len(payload)) + payload)


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--port", type=int, default=6742)
    ap.add_argument("--hz", type=float, default=5.0)
    ap.add_argument("--max-hp", type=int, default=100)
    args = ap.parse_args()

    if os.geteuid() != 0:
        raise SystemExit("Run with sudo: sudo terraria-rgb")

    pid = find_pid()
    if not pid:
        raise SystemExit("Terraria process not found")
    mem = open_mem(pid)
    addr, max_hp = find_hp_address(pid, mem, args.max_hp)
    if addr is None:
        raise SystemExit("HP pattern not found (game version may differ)")
    print(f"Terraria pid={pid} HP address={hex(addr)} max={max_hp}", flush=True)

    s = connect_sdk(args.port)
    interval = 1.0 / args.hz
    try:
        while True:
            hp = read_hp(mem, addr)
            if hp is None:
                break
            if hp > max_hp:
                # armor/life upgrades change the pattern -> re-scan
                addr, max_hp = find_hp_address(pid, mem, hp)
                if addr is None:
                    break
                hp = read_hp(mem, addr)
            mana = read_hp(mem, addr + 4) or 0
            max_mana = read_hp(mem, addr + 8) or 120
            colors = [(0, 0, 0)] * 128
            hp_c = bar_color(hp / max(1, max_hp))
            mana_c = bar_color(mana / max(1, max_mana),
                               low=(60, 0, 255), high=(0, 160, 255))
            for i, slot in enumerate(F_KEYS):
                colors[slot] = (255, 0, 0) if hp == 0 else (
                    hp_c if i < round(10 * hp / max(1, max_hp)) else (0, 0, 0))
            for i, slot in enumerate(NUM_KEYS):
                colors[slot] = mana_c if i < round(10 * mana / max(1, max_mana)) else (0, 0, 0)
            forest = read_hp(mem, addr + FOREST_OFF)
            desert = read_hp(mem, addr + DESERT_OFF)
            snow = read_hp(mem, addr + SNOW_OFF)
            if forest == 10:
                biome = "forest"
            elif desert == 1:
                biome = "desert"
            elif snow == 5:
                biome = "snow"
            else:
                biome = "unknown"
            for slot in WASD:
                colors[slot] = BIOME_COLORS[biome]
            send_colors(s, colors)
            time.sleep(interval)
    except KeyboardInterrupt:
        pass
    finally:
        s.close()
        os.close(mem)


if __name__ == "__main__":
    main()
