#!/usr/bin/env python3
"""RGB lighting control for EVision-based keyboards.

Communicates with the keyboard's vendor HID interface directly through
libhidapi-libusb, bypassing the generic HID driver.  Provides hardware
effects, persistent per-key color sets and a live per-key update mode.
"""
import ctypes
import json
import os
import sys
import time

VID, PID = 0x320F, 0x5055
PACKET_SIZE = 64
REPORT_ID = 4
CMD_BEGIN = 0x01
CMD_END = 0x02
CMD_CAPS = 0x03
CMD_READ_CONFIG = 0x05
CMD_WRITE_CONFIG = 0x06
CMD_WRITE_CUSTOM_COLORS = 0x0B
CMD_SEND_DYNAMIC = 0x12
CMD_END_DYNAMIC = 0x13

OFFSET_PROFILE = 0x00
OFFSET_FIRST_PROFILE = 0x01
PROFILE_SIZE = 0x40

# Parameter offsets inside profile config block (first 8 bytes used)
P_MODE, P_BRIGHTNESS, P_SPEED, P_DIRECTION = 0, 1, 2, 3
P_RANDOM, P_COLOR_R, P_COLOR_G, P_COLOR_B = 4, 5, 6, 7
P_CURRENT_CUSTOM_MODE = 0x19
MODE_CUSTOM = 0x14

MODES = {
    "wave-short": 0x01, "wave-long": 0x02, "wheel": 0x03, "spectrum": 0x04,
    "breathing": 0x05, "static": 0x06, "reactive": 0x07, "reactive-ripple": 0x08,
    "reactive-line": 0x09, "starlight-fast": 0x0A, "blooming": 0x0B,
    "rainbow-vertical": 0x0C, "hurricane": 0x0D, "accumulate": 0x0E,
    "starlight-slow": 0x0F, "visor": 0x10, "surmount": 0x11,
    "rainbow-circle": 0x12, "custom": 0x14, "direct": 0xFF,
}
MODE_NAMES = {v: k for k, v in MODES.items()}

CMD_READ_KEYMAP = 0x07

# Standard HID keyboard usages -> short names used by the `key` command.
HID_NAMES = {
    0x29: "esc", 0x35: "grave", 0x2b: "tab", 0x39: "caps",
    0x2a: "backspace", 0x2c: "space", 0x28: "enter",
    0x2d: "minus", 0x2e: "equal", 0x2f: "leftbracket", 0x30: "rightbracket",
    0x31: "backslash", 0x33: "semicolon", 0x34: "quote",
    0x36: "comma", 0x37: "period", 0x38: "slash",
    0x46: "prtsc", 0x47: "scrlk", 0x48: "pause", 0x49: "insert",
    0x4a: "home", 0x4b: "pgup", 0x4c: "delete", 0x4d: "end", 0x4e: "pgdn",
    0x4f: "right", 0x50: "left", 0x51: "down", 0x52: "up",
    0x53: "numlock", 0x54: "numslash", 0x55: "numasterisk", 0x56: "numminus",
    0x57: "numplus", 0x58: "numenter", 0x62: "num0", 0x63: "numdot",
}
for _i, _k in enumerate("abcdefghijklmnopqrstuvwxyz"):
    HID_NAMES[0x04 + _i] = _k
for _i in range(10):
    HID_NAMES[0x1e + _i] = str((_i + 1) % 10)
for _i in range(12):
    HID_NAMES[0x3a + _i] = f"f{_i + 1}"
for _i in range(9):
    HID_NAMES[0x59 + _i] = f"num{_i + 1}"

# ---------------------------------------------------------------- libhidapi
_lib = ctypes.CDLL("libhidapi-libusb.so.0")

class _Info(ctypes.Structure):
    pass
_Info._fields_ = [
    ("path", ctypes.c_char_p), ("vendor_id", ctypes.c_ushort),
    ("product_id", ctypes.c_ushort), ("serial_number", ctypes.c_void_p),
    ("release_number", ctypes.c_ushort), ("manufacturer_string", ctypes.c_void_p),
    ("product_string", ctypes.c_void_p), ("usage_page", ctypes.c_ushort),
    ("usage", ctypes.c_ushort), ("interface_number", ctypes.c_int),
    ("next", ctypes.POINTER(_Info)),
]
for _n, _r, _a in [
    ("hid_init", ctypes.c_int, []), ("hid_exit", ctypes.c_int, []),
    ("hid_enumerate", ctypes.POINTER(_Info), [ctypes.c_ushort, ctypes.c_ushort]),
    ("hid_open_path", ctypes.c_void_p, [ctypes.c_char_p]),
    ("hid_write", ctypes.c_int, [ctypes.c_void_p, ctypes.c_void_p, ctypes.c_size_t]),
    ("hid_read_timeout", ctypes.c_int, [ctypes.c_void_p, ctypes.c_void_p, ctypes.c_size_t, ctypes.c_int]),
    ("hid_close", None, [ctypes.c_void_p]),
]:
    _f = getattr(_lib, _n); _f.restype = _r; _f.argtypes = _a


class Keyboard:
    def __init__(self):
        _lib.hid_init()
        self.dev = None
        d = _lib.hid_enumerate(VID, PID)
        paths = []
        while d:
            di = d.contents
            if di.interface_number == 1:
                paths.append(bytes(di.path))
            d = di.next
        for p in paths:
            self.dev = _lib.hid_open_path(p)
            if self.dev:
                self.path = p
                break
        if not self.dev:
            raise RuntimeError("EVision interface 1 not reachable (is the udev unbind rule active?)")

        # Discard stale reports queued from previous runs.
        while True:
            tmp = (ctypes.c_ubyte * PACKET_SIZE)()
            if _lib.hid_read_timeout(self.dev, tmp, PACKET_SIZE, 30) <= 0:
                break

    def close(self):
        if self.dev:
            _lib.hid_close(self.dev)
            self.dev = None
        _lib.hid_exit()

    def __enter__(self):
        return self

    def __exit__(self, *a):
        self.close()

    def query(self, cmd, offset=0, data=b"", size=None, timeout=1200):
        if size is None:
            size = len(data)
        if size > PACKET_SIZE - 8:
            raise ValueError("packet too large")
        pkt = bytearray(PACKET_SIZE)
        pkt[0] = REPORT_ID
        pkt[3] = cmd
        pkt[4] = size
        pkt[5] = offset & 0xFF
        pkt[6] = (offset >> 8) & 0xFF
        pkt[8:8 + len(data)] = data
        chk = sum(pkt[3:]) & 0xFFFF
        pkt[1] = chk & 0xFF
        pkt[2] = chk >> 8
        self._write(bytes(pkt))

        resp = (ctypes.c_ubyte * PACKET_SIZE)()
        deadline = time.time() + timeout / 1000.0
        # Short reports are ordinary key input on the same interface — skip them.
        while True:
            remaining = int((deadline - time.time()) * 1000)
            if remaining <= 0:
                raise RuntimeError("no response (timeout)")
            n = _lib.hid_read_timeout(self.dev, resp, PACKET_SIZE, remaining)
            if n == PACKET_SIZE and resp[0] == REPORT_ID and resp[3] == cmd:
                break
        b = bytes(resp)
        if b[0] != REPORT_ID or b[3] != cmd:
            raise RuntimeError(f"unexpected response: {b[:12].hex()}")
        if b[7] != 0:
            raise RuntimeError(f"device returned error {b[7]:#x}")
        return b[8:8 + b[4]]

    def _write(self, pkt):
        for attempt in range(4):
            if _lib.hid_write(self.dev, pkt, PACKET_SIZE) == PACKET_SIZE:
                return
            time.sleep(0.02 * (attempt + 1))
        raise RuntimeError("hid_write failed")

    def read(self, cmd, offset, size):
        out = bytearray()
        while size > 0:
            chunk = min(size, PACKET_SIZE - 8)
            out += self.query(cmd, offset, b"", chunk)
            offset += chunk
            size -= chunk
        return bytes(out)

    def write(self, cmd, offset, data):
        for i in range(0, len(data), PACKET_SIZE - 8):
            chunk = data[i:i + PACKET_SIZE - 8]
            self.query(cmd, offset + i, chunk, len(chunk))

    def keymap(self):
        """Read HID keymap; returns {key_name: led_slot}.

        The firmware returns 3-byte records: [page, hi, lo].  The record index
        (including d0 a2 NN gap markers) is the RGB LED slot.  Verified on the
        device: 0=Esc, 1=grave, 2=Tab, 8=F1, 9=1, 10=Q.
        """
        raw = self.read(CMD_READ_KEYMAP, 0, 384)
        result = {}
        for slot, off in enumerate(range(0, len(raw) - 2, 3)):
            page, hi, lo = raw[off:off + 3]
            if page != 0x20 or lo == 0:
                continue
            name = HID_NAMES.get(lo)
            if name and name not in result:
                result[name] = slot
        return result

    def caps(self):
        c = self.query(CMD_CAPS, 0, b"", 7)
        if c[0] != 0xAA or c[1] != 0x55:
            raise RuntimeError(f"bad capabilities: {c.hex()}")
        return c

    def profile(self):
        p = self.query(CMD_READ_CONFIG, OFFSET_PROFILE, b"", 1)[0]
        return p if p <= 2 else 0

    def config(self, profile=None):
        if profile is None:
            profile = self.profile()
        c = self.read(CMD_READ_CONFIG, profile * PROFILE_SIZE + OFFSET_FIRST_PROFILE, 18)
        return {
            "mode": c[P_MODE], "brightness": c[P_BRIGHTNESS], "speed": c[P_SPEED],
            "direction": c[P_DIRECTION], "random": c[P_RANDOM] != 0,
            "color": (c[P_COLOR_R], c[P_COLOR_G], c[P_COLOR_B]),
            "raw": c, "profile": profile,
        }

    # ---------------------------------------------------------- direct mode
    def set_dynamic(self, colors):
        """Write up to 128 slot colors. colors: iterable of (r,g,b)."""
        buf = bytearray(128 * 3)
        for i, c in enumerate(colors):
            if i >= 128:
                break
            buf[i*3:i*3+3] = bytes(c)
        self.write(CMD_SEND_DYNAMIC, 0, bytes(buf))

    def set_dynamic_raw(self, colors):
        """Send a full frame without waiting for ACKs (for continuous refresh).

        This firmware stops answering after prolonged querying, so the
        steady-state keepalive must be fire-and-forget.
        """
        buf = bytearray(128 * 3)
        for i, c in enumerate(colors):
            if i >= 128:
                break
            buf[i*3:i*3+3] = bytes(c)
        for i in range(0, len(buf), PACKET_SIZE - 8):
            chunk = buf[i:i + PACKET_SIZE - 8]
            pkt = bytearray(PACKET_SIZE)
            pkt[0] = REPORT_ID
            pkt[3] = CMD_SEND_DYNAMIC
            pkt[4] = len(chunk)
            pkt[5] = i & 0xFF
            pkt[6] = (i >> 8) & 0xFF
            pkt[8:8 + len(chunk)] = chunk
            chk = sum(pkt[3:]) & 0xFFFF
            pkt[1] = chk & 0xFF
            pkt[2] = chk >> 8
            self._write(bytes(pkt))
        tmp = (ctypes.c_ubyte * PACKET_SIZE)()
        while _lib.hid_read_timeout(self.dev, tmp, PACKET_SIZE, 5) > 0:
            pass

    def refresh_dynamic(self, blank=6):
        # Fire-and-forget: this firmware does not send a 64-byte reply to the
        # keepalive packet.  Waiting for one only drains stale color ACKs and
        # then times out.
        off = blank * 3
        pkt = bytearray(PACKET_SIZE)
        pkt[0] = REPORT_ID
        pkt[3] = CMD_SEND_DYNAMIC
        pkt[4] = 1
        pkt[5] = off & 0xFF
        pkt[6] = (off >> 8) & 0xFF
        chk = sum(pkt[3:]) & 0xFFFF
        pkt[1] = chk & 0xFF
        pkt[2] = chk >> 8
        self._write(bytes(pkt))
        # Keep the IN queue from filling up with ordinary 3-byte key reports.
        tmp = (ctypes.c_ubyte * PACKET_SIZE)()
        while _lib.hid_read_timeout(self.dev, tmp, PACKET_SIZE, 5) > 0:
            pass

    def end_dynamic(self):
        try:
            self.query(CMD_END_DYNAMIC, timeout=300)
        except Exception:
            pass

    def direct_loop(self, colors, seconds=0, blank=6):
        self.set_dynamic(colors)
        started = time.time()
        failures = 0
        try:
            while seconds <= 0 or time.time() - started < seconds:
                time.sleep(0.2)
                try:
                    # Re-send the full frame: this firmware ignores the
                    # one-byte "blank space" keepalive used by other models.
                    self.set_dynamic(colors)
                    failures = 0
                except Exception:
                    failures += 1
                    if failures >= 5:
                        break
        except KeyboardInterrupt:
            pass
        finally:
            self.end_dynamic()

    def write_custom_colors(self, colors, colorset=0):
        """Write only the color map into keyboard flash (no mode switch)."""
        buf = bytearray(128 * 3)
        for i, c in enumerate(colors):
            if i >= 128:
                break
            buf[i*3:i*3+3] = bytes(c)
        self.query(CMD_BEGIN)
        self.write(CMD_WRITE_CUSTOM_COLORS, 512 * colorset, bytes(buf))
        self.query(CMD_END)

    def set_custom(self, colors, colorset=0):
        """Store a 128-slot color map in keyboard flash (custom colorset 0-9)
        and switch the active profile to custom mode — no daemon needed."""
        self.write_custom_colors(colors, colorset)

        prof = self.profile()
        base = prof * PROFILE_SIZE + OFFSET_FIRST_PROFILE
        self.query(CMD_BEGIN)
        self.write(CMD_WRITE_CONFIG, base + P_CURRENT_CUSTOM_MODE,
                   bytes([colorset]))
        self.query(CMD_END)
        self.set_config(mode=MODE_CUSTOM)

    def set_config(self, mode=None, brightness=None, speed=None, color=None, profile=None):
        cur = self.config(profile)
        buf = bytearray(cur["raw"])
        if mode is not None: buf[P_MODE] = mode
        if brightness is not None: buf[P_BRIGHTNESS] = brightness
        if speed is not None: buf[P_SPEED] = speed
        if color is not None:
            buf[P_COLOR_R], buf[P_COLOR_G], buf[P_COLOR_B] = color
        buf[P_RANDOM] = 0
        target = cur["profile"] if profile is None else profile
        offset = target * PROFILE_SIZE + OFFSET_FIRST_PROFILE
        self.query(CMD_BEGIN)
        self.write(CMD_WRITE_CONFIG, offset, bytes(buf[:8]))
        self.query(CMD_END)


def rainbow_colors():
    import colorsys
    out = [(0, 0, 0)] * 128
    for slot in range(128):
        r, g, b = colorsys.hsv_to_rgb(slot / 128.0, 1.0, 1.0)
        out[slot] = (int(r * 255), int(g * 255), int(b * 255))
    return out


def parse_color(s):
    s = s.lstrip("#")
    if len(s) != 6:
        raise ValueError("color must be RRGGBB")
    return tuple(int(s[i:i+2], 16) for i in (0, 2, 4))


def cmd_status(kb):
    c = kb.caps()
    cfg = kb.config()
    mode = MODE_NAMES.get(cfg["mode"], hex(cfg["mode"]))
    print(f"path:       {kb.path.decode()}")
    print(f"caps:       {c.hex()}  map_size={c[5]} macros={c[6] * 0x80}")
    print(f"profile:    {cfg['profile']}")
    print(f"mode:       {cfg['mode']:#04x} ({mode})")
    print(f"brightness: {cfg['brightness']}")
    print(f"speed:      {cfg['speed']}")
    print(f"direction:  {cfg['direction']}")
    print(f"random:     {cfg['random']}")
    print(f"color:      #{''.join(f'{x:02x}' for x in cfg['color'])}")


def main():
    if len(sys.argv) < 2:
        print(__doc__)
        return 1
    cmd = sys.argv[1]
    with Keyboard() as kb:
        if cmd == "status":
            cmd_status(kb)
        elif cmd in ("static", "color"):
            color = parse_color(sys.argv[2])
            kb.set_config(mode=MODES["static"], color=color,
                          brightness=int(sys.argv[3]) if len(sys.argv) > 3 else None)
            print("set:", kb.config())
        elif cmd == "effect":
            name = sys.argv[2]
            mode = MODES[name] if name in MODES else int(name, 0)
            kwargs = {"mode": mode}
            for a in sys.argv[3:]:
                k, v = a.split("=", 1)
                kwargs[k] = int(v, 0) if k != "color" else parse_color(v)
            kb.set_config(**kwargs)
            print("set:", kb.config())
        elif cmd == "save":
            cfg = kb.config()
            cfg["raw"] = cfg["raw"].hex()
            path = os.path.expanduser("~/.config/evision-rgb.json")
            os.makedirs(os.path.dirname(path), exist_ok=True)
            with open(path, "w") as f:
                json.dump(cfg, f)
            print("saved current config to", path)
        elif cmd == "restore":
            path = os.path.expanduser("~/.config/evision-rgb.json")
            with open(path) as f:
                cfg = json.load(f)
            kb.write(CMD_WRITE_CONFIG,
                     cfg["profile"] * PROFILE_SIZE + OFFSET_FIRST_PROFILE,
                     bytes.fromhex(cfg["raw"])[:8])
            print("restored:", kb.config())
        elif cmd == "effects":
            for name, mode in sorted(MODES.items()):
                print(f"  {name:20s} {mode:#04x}")
        elif cmd == "direct":
            color = parse_color(sys.argv[2])
            seconds = float(sys.argv[3]) if len(sys.argv) > 3 else 0
            print(f"Direct: all slots #{''.join(f'{x:02x}' for x in color)} "
                  f"for {seconds or 'infinite'}s (Ctrl-C to stop)")
            kb.direct_loop([color] * 128, seconds)
        elif cmd == "probe":
            slot = int(sys.argv[2], 0)
            color = parse_color(sys.argv[3])
            seconds = float(sys.argv[4]) if len(sys.argv) > 4 else 5
            colors = [(0, 0, 0)] * 128
            colors[slot] = color
            print(f"Probe slot {slot} = #{''.join(f'{x:02x}' for x in color)} for {seconds}s")
            kb.direct_loop(colors, seconds)
        elif cmd == "keys":
            for name, slot in sorted(kb.keymap().items(), key=lambda x: x[1]):
                print(f"  {name:14s} {slot:3d}")
        elif cmd == "custom":
            slots = kb.keymap()
            colors = [(0, 0, 0)] * 128
            for spec in sys.argv[2:]:
                name, value = spec.split("=", 1)
                if name not in slots:
                    raise SystemExit(f"unknown key: {name}")
                colors[slots[name]] = parse_color(value)
                print(f"  {name} -> slot {slots[name]} = {value}")
            kb.set_custom(colors)
            print("stored in keyboard flash (custom mode)")
        elif cmd == "rainbow":
            kb.set_custom(rainbow_colors())
            print("rainbow stored in keyboard flash (custom mode, no daemon)")
        elif cmd == "once":
            colors = [(0, 0, 0)] * 128
            for spec in sys.argv[2:]:
                name, value = spec.split("=", 1)
                slots = kb.keymap()
                if name not in slots:
                    raise SystemExit(f"unknown key: {name}")
                colors[slots[name]] = parse_color(value)
                print(f"  {name} -> slot {slots[name]} = {value}")
            kb.set_dynamic(colors)
            print("frame sent (no keepalive)")
        elif cmd == "slots":
            seconds = float(sys.argv[-1]) if sys.argv[-1].replace('.', '', 1).isdigit() else 0
            specs = sys.argv[2:]
            if seconds:
                specs = specs[:-1]
            colors = [(0, 0, 0)] * 128
            for spec in specs:
                slot, value = spec.split("=", 1)
                colors[int(slot, 0)] = parse_color(value)
                print(f"  slot {slot} = {value}")
            kb.direct_loop(colors, seconds)
        elif cmd == "key":
            seconds = float(sys.argv[-1]) if sys.argv[-1].replace('.', '', 1).isdigit() else 0
            specs = sys.argv[2:]
            if seconds:
                specs = specs[:-1]
            slots = kb.keymap()
            colors = [(0, 0, 0)] * 128
            for spec in specs:
                name, value = spec.split("=", 1)
                name = name.lower()
                if name not in slots:
                    raise SystemExit(f"unknown key: {name} (see 'evision-rgb keys')")
                colors[slots[name]] = parse_color(value)
                print(f"  {name} -> slot {slots[name]} = {value}")
            print(f"Direct per-key for {seconds or 'infinite'}s (Ctrl-C to stop)")
            kb.direct_loop(colors, seconds)
        elif cmd == "enddirect":
            kb.end_dynamic()
            print("direct mode ended")
        else:
            print("unknown command:", cmd)
            return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
